# reflections.crishub.com
#
# One job: let the single-page app own every path that is not a real file.
# /api belongs to the host's Node application manager, which writes its own
# rules above these.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- the API -----------------------------------------------------------
  #
  # There is deliberately no proxy rule here.
  #
  # Proxying to a local port from .htaccess was the original plan and it does
  # not work on this host: a `RewriteRule ... [P]` to 127.0.0.1 answers 503,
  # tested against reflections.crishub.com with a listener confirmed running on
  # the loopback. Shared plans do not permit mod_proxy, and a rule that 503s is
  # worse than no rule, because the failure looks like the API is broken rather
  # than absent.
  #
  # The API is mounted by the host's Node application manager instead (hPanel
  # -> Setup Node.js App), which writes its own rules ABOVE this file's — see
  # scripts/deploy/README.md. Do not add a /api rule here: the manager owns
  # that path, and a rule here would shadow it.

  # --- the app -----------------------------------------------------------
  #
  # A real file wins; everything else is the app's own route. Without this a
  # reload on /reflections asks the server for a directory that is not there
  # and gets a 404 on a page that exists.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# Hashed assets are immutable; index.html must never be, or a deploy is
# invisible until someone clears their cache.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|svg|jpg|jpeg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Nothing here should be readable as source.
<FilesMatch "\.(env|sqlite|sqlite-wal|sqlite-shm|ts|map)$">
  Require all denied
</FilesMatch>
