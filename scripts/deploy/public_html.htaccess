# reflections.crishub.com
#
# Two jobs: hand /api to the Node process, and let the single-page app own
# every other path.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- the API -----------------------------------------------------------
  #
  # The Node process listens on the loopback only. This is the one route to
  # it, so the port is never reachable from outside.
  #
  # If your plan manages Node through hPanel instead, that tool mounts the app
  # at a URL itself — delete this block and set VITE_API_BASE_URL to whatever
  # URL it gives you, then rebuild. `preflight.sh` reports which case you are
  # in.
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^api/(.*)$ http://127.0.0.1:8000/api/$1 [P,L,QSA]

  # --- the app -----------------------------------------------------------
  #
  # A real file wins; everything else is the app's own route. Without this a
  # reload on /reflections asks the server for a directory that is not there
  # and gets a 404 on a page that exists.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# Hashed assets are immutable; index.html must never be, or a deploy is
# invisible until someone clears their cache.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|svg|jpg|jpeg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Nothing here should be readable as source.
<FilesMatch "\.(env|sqlite|sqlite-wal|sqlite-shm|ts|map)$">
  Require all denied
</FilesMatch>
