# API
PORT=8000

# Where the SQLite file lives. One file, WAL mode, created on first start.
# The demonstrable app still uses this store. Durable MySQL persistence is
# applied alongside it when MYSQL_HOST is set; request handlers switch later.
DATABASE_PATH=chat.sqlite

# Hostinger MariaDB (11.8.x) durable store. The same MYSQL_* vars work for
# local MariaDB/MySQL. Unset = skip this path on boot and in the default test
# run. Never put real credentials in this file.
# MYSQL_HOST=srv1780.hstgr.io
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=u471078694_reflections
# MYSQL_SSL=true
# Apply schema: npm run db:migrate -w api

# The session cookie is marked `secure` only when this is exactly `production`.
# Leave it unset in development: a secure cookie never arrives over plain-HTTP
# localhost, so setting it here would look like a broken login rather than a
# hardened one. Set it in every deployed environment.
# NODE_ENV=production

# Web (Vite). Leave as /api to use the local Vite proxy during development.
# A packaged Capacitor build cannot use that proxy — set an absolute API origin
# when running `npm run cap:sync` for a device/emulator binary.
VITE_API_BASE_URL=/api

# Extra browser origins allowed to call the API with cookies, comma-separated.
# Capacitor WebView origins are already included. Add a deployed web host here.
# CHAT_WEB_ORIGINS=https://chat.example

# Point the native WebView at the Vite dev server so `/api` still proxies and
# the session cookie stays first-party. Unset for a packaged binary.
# CAP_LIVE_RELOAD_URL=http://127.0.0.1:5173

# --------------------------------------------- Studio generated backgrounds
# Disabled unless a server-side provider is selected. `deterministic` is the
# original local development stand-in: no network, model, credential, or claim
# of AI generation. Production providers implement the server-only seam.
STUDIO_IMAGE_PROVIDER=

# ---------------------------------------------------------------- AI assist
#
# Copy this file to `.env` and fill in your own values. `.env` is gitignored;
# this file is committed and must never contain a real credential.
#
# The app starts, and the whole manual writing workflow works, with every
# variable below unset. Assistance is off by default and says so.

# The kill switch. Off unless explicitly turned on. Setting this to false at
# runtime stops every provider call without a redeploy.
AI_ENABLED=false

# Which adapter answers. `gemini` in real use; `fake` is a deterministic
# stand-in with no network and no key, used by tests and browser verification.
AI_PROVIDER=gemini

# Your own Google AI Studio key. Leave EMPTY here — this file is committed.
# Put the real value in `.env`, or export it in the shell that runs the API.
# It is read only by the backend. The browser must never see it.
GEMINI_API_KEY=

# The model is configuration, not a constant: changing it needs no code edit.
# Use a stable model, never a preview one.
GEMINI_MODEL=gemini-3.5-flash-lite

# How long a single provider call may take before it is abandoned.
AI_REQUEST_TIMEOUT_MS=15000

# The ceiling on how much text one request may send to the provider.
AI_MAX_INPUT_CHARS=12000

# Assistance requests per minute, per signed-in user. The per-address ceiling
# is four times this, so one household behind one address is not treated as
# one person.
AI_RATE_LIMIT_PER_MINUTE=12

# Switches off ALL assistance, including the heuristic title suggestion that
# needs no provider at all. Predates AI_ENABLED and still honoured.
# CHAT_AI_DISABLED=1

# Set to 1 alongside a real GEMINI_API_KEY to allow the opt-in developer smoke
# test to make one real call. Never set this in CI.
# AI_LIVE_TEST=1

# ------------------------------------------------------- Bible passage lookup
#
# The connector that fetches the passage a reflection is written against. It
# talks to the YouVersion Platform API from the BACKEND ONLY — the key must
# never reach a browser bundle, and nothing in `web_app/` reads it.

# On by default, unlike assistance. A lookup sends a Bible reference and nothing
# else — no reflection, no account, no text anyone wrote — and a Bible app whose
# Bible has to be switched on is a broken Bible app. Set to false to stop every
# provider call without a redeploy.
BIBLE_ENABLED=true

# Your YouVersion Platform app key. Leave EMPTY here — this file is committed.
# Put the real value in `.env`, or export it in the shell that runs the API:
#
#   set -a; . ~/.config/chat_app/youversion.env; set +a
#
# With it unset the app starts, the whole writing workflow works, and the
# passage card says "Bible passage lookup is not configured."
YVP_APP_KEY=

# The provider's base URL. Configuration, not a constant, so a staging host
# needs no code edit.
YVP_API_BASE_URL=https://api.youversion.com/v1

# The languages the translation catalog is assembled from.
#
# This matters more than it looks: **the provider has no "list every Bible"
# call** — a request without a language range is rejected outright — so the
# catalog is exactly this list. A language nobody adds here is a language whose
# Bibles do not exist as far as this application is concerned.
#
# The default is en,tl,ceb,es,fr,de,zh. Filipino and Cebuano are in it because
# they are the languages of the communities this product was built for, and a
# Bible app that cannot offer somebody a Bible in their own language has failed
# at the only thing it does. Add more freely: each one costs a single list
# request, once per catalog lifetime.
#
# Verified against the key on 2026-08-16 (translations per language):
#   en 20 · es 8 · de 7 · fr 6 · zh 3 · tl 2 · ceb 1
# BIBLE_LANGUAGES=en,tl,ceb,es,fr,de,zh

# How long a single lookup may take before it is abandoned.
BIBLE_REQUEST_TIMEOUT_MS=8000

# How long the translation catalog may be reused. A day: it changes a few times
# a year, and re-fetching it per request is rude to the provider.
BIBLE_CATALOG_TTL_MS=86400000

# How long a fetched passage stays in memory. Minutes, not days — this is a
# window for collapsing a burst of identical requests, NOT a store. Passage text
# is copyrighted and is never accumulated on disk as an optimisation.
BIBLE_PASSAGE_TTL_MS=900000

# Passage lookups per minute, per signed-in user. The per-address ceiling is
# four times this.
BIBLE_RATE_LIMIT_PER_MINUTE=30

# Whether passage TEXT may be included in a prompt sent to the AI provider.
# OFF by default: it is a licensing decision, not an engineering one. The
# reference is always sent; the words are not, unless this says so.
BIBLE_SCRIPTURE_IN_PROMPTS=false

# Set to 1 alongside a real YVP_APP_KEY to allow the opt-in live check to make
# real calls. Never set this in CI.
# BIBLE_LIVE_TEST=1
