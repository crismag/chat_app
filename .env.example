# API
PORT=8000

# Web (Vite). Leave as /api to use the local Vite proxy during development.
VITE_API_BASE_URL=/api

# ---------------------------------------------------------------- AI assist
#
# Copy this file to `.env` and fill in your own values. `.env` is gitignored;
# this file is committed and must never contain a real credential.
#
# The app starts, and the whole manual writing workflow works, with every
# variable below unset. Assistance is off by default and says so.

# The kill switch. Off unless explicitly turned on. Setting this to false at
# runtime stops every provider call without a redeploy.
AI_ENABLED=false

# Which adapter answers. `gemini` in real use; `fake` is a deterministic
# stand-in with no network and no key, used by tests and browser verification.
AI_PROVIDER=gemini

# Your own Google AI Studio key. Leave EMPTY here — this file is committed.
# Put the real value in `.env`, or export it in the shell that runs the API.
# It is read only by the backend. The browser must never see it.
GEMINI_API_KEY=

# The model is configuration, not a constant: changing it needs no code edit.
# Use a stable model, never a preview one.
GEMINI_MODEL=gemini-2.5-flash-lite

# How long a single provider call may take before it is abandoned.
AI_REQUEST_TIMEOUT_MS=15000

# The ceiling on how much text one request may send to the provider.
AI_MAX_INPUT_CHARS=12000

# Assistance requests per minute, per signed-in user. The per-address ceiling
# is four times this, so one household behind one address is not treated as
# one person.
AI_RATE_LIMIT_PER_MINUTE=12

# Switches off ALL assistance, including the heuristic title suggestion that
# needs no provider at all. Predates AI_ENABLED and still honoured.
# CHAT_AI_DISABLED=1

# Set to 1 alongside a real GEMINI_API_KEY to allow the opt-in developer smoke
# test to make one real call. Never set this in CI.
# AI_LIVE_TEST=1
