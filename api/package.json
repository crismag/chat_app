{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../.env src/index.ts",
    "dev:watch": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=../.env src/mysql/cli.ts",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chat/shared": "*",
    "@google/genai": "^2.17.1",
    "@hono/node-server": "^1.19.9",
    "argon2": "^0.45.1",
    "hono": "^4.11.7",
    "mysql2": "^3.23.3",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "oxlint": "^1.75.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.18"
  }
}
