{
  "name": "chat-app",
  "private": true,
  "version": "0.1.0",
  "description": "C.H.A.T. — Context, Heart, Application, Testimony",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "web_app",
    "api",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm run dev -w web_app\" \"npm run dev -w api\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "selenium-webdriver": "^4.47.0"
  }
}
